            <column-instance column='[TLD_Group]' derivation='None' name='[none:TLD_Group:nk]' pivot='key' type='nominal' />
            <column-instance column='[Website_Status]' derivation='None' name='[none:Website_Status:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1580860170960896]' derivation='User' name='[usr:Calculation_1580860170960896:qk]' pivot='key' type='quantitative' />
