            <column caption='Phishing Rate' datatype='real' name='[Calculation_1580860170960896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [label] = 0 THEN 1 ELSE 0 END) / COUNT([label])' />
            </column>
            <column caption='HTTPS Used' datatype='string' name='[HTTPS_Used]' role='dimension' type='nominal' />
            <column caption='TLD Group' datatype='string' name='[TLD_Group]' role='dimension' type='nominal' />
